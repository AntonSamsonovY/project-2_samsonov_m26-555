[0.120048, "o", "Примитивная база данных\r\nКоманды:\r\n  create_table <имя> <колонка:тип> ... — создать таблицу\r\n  drop_table <имя> — удалить таблицу\r\n  list_tables — показать список таблиц\r\n  insert into <имя> values (...) — добавить запись\r\n  select from <имя> [where колонка = значение] — показать записи\r\n  update <имя> set колонка = значение where условие — изменить записи\r\n  delete from <имя> where условие — удалить записи\r\n  info <имя> — показать информацию о таблице\r\n  help — показать справку\r\n  exit — выйти\r\nВведите команду: "]
